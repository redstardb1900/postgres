# zh_CN supplement for postgres (REL_16_11).
#
# Exact-match compendium used by po_sync.py merge (msgmerge -C): messages
# whose msgid exists in the REL_16_11 POT but has no exact translation in
# pgnls zh_CN/REL_16_STABLE.  Every entry is a hand translation made with
# the pgnls terminology (ref/style-guide.md > phrasebook > glossary) and
# carries the "zh-review-pending" translator comment until GPT review
# signs it off.  Where another pgnls branch already has the identical
# msgid, that translation is reused verbatim and the source is noted.
msgid ""
msgstr ""
"Project-Id-Version: postgres (PostgreSQL) 16 zh_CN supplement\n"
"Language: zh_CN\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

# zh-review-pending: msgid dropped the leading "To avoid a database shutdown," clause; translation reused verbatim from pgnls zh_CN/REL_17_STABLE and REL_18_STABLE postgres.po (identical msgid)
#: access/transam/multixact.c:1025
msgid ""
"Execute a database-wide VACUUM in that database.\n"
"You might also need to commit or roll back old prepared transactions, or drop stale replication slots."
msgstr ""
"在该数据库中执行全库 VACUUM。\n"
"您可能还需要提交或回滚旧的预备事务，或删除过期的复制槽。"

# zh-review-pending: format changed %lld -> %u for the offset; translation reused verbatim from pgnls zh_CN/REL_17_STABLE, REL_18_STABLE and master postgres.po (identical msgid)
#: backup/basebackup_server.c:181
#, c-format
msgid "could not write file \"%s\": wrote only %d of %d bytes at offset %u"
msgstr "无法写入文件 \"%1$s\": 在偏移量 %4$u 处应写入 %3$d 字节，实际仅写入 %2$d 字节"

# zh-review-pending: new wording (was "shutting down due to ..."); translation reused verbatim from pgnls zh_CN/REL_14_STABLE, REL_18_STABLE and master postgres.po (identical msgid)
#: postmaster/postmaster.c:3040
#, c-format
msgid "aborting startup due to startup process failure"
msgstr "因启动进程失败而中止启动"

# zh-review-pending: new message in REL_16_11 (no pgnls branch has it); "replication origin" = 复制源 as in pgnls REL_16_STABLE ("ID 为 %d 的复制源不存在"), pattern "X \"%s\" 已存在" as in "复制槽 \"%s\" 已存在"
#: replication/logical/tablesync.c:1486
#, c-format
msgid "replication origin \"%s\" already exists"
msgstr "复制源 \"%s\" 已存在"

# zh-review-pending: format changed %ld -> %d; wording follows the pgnls REL_16_STABLE translation of the %zu variant "字符串对于 tsvector 过长（%zu 字节，最多 %zu 字节）"
#: tsearch/to_tsany.c:195
#, c-format
msgid "string is too long for tsvector (%d bytes, max %d bytes)"
msgstr "字符串对于 tsvector 过长（%d 字节，最多 %d 字节）"

# zh-review-pending: OVERRIDE of a translation msgmerge revived from a pgnls REL_16_STABLE obsolete entry ("字符串对于tsvector来说太长了(当前 %ld字节, 最大允许值是%ld字节)", retired upstream); aligned with the active %zu variant above per style-guide R4.3 (fullwidth parentheses) and R5 (spaces around the ASCII token)
#: utils/adt/tsvector.c:221
#, c-format
msgid "string is too long for tsvector (%ld bytes, max %ld bytes)"
msgstr "字符串对于 tsvector 过长（%ld 字节，最多 %ld 字节）"

# zh-review-pending: OVERRIDE of a translation msgmerge revived from a pgnls REL_16_STABLE obsolete entry ("所要求的共享内存大小超过size_t", retired upstream); "overflows" rendered as 超出 ... 范围 like the active "value overflows numeric format" = "值超出 numeric 格式范围", space before the ASCII token per style-guide R5
#: storage/ipc/shmem.c:511
#, c-format
msgid "requested shared memory size overflows size_t"
msgstr "请求的共享内存大小超出 size_t 范围"
