{
  "_doc": "Fixed negative/positive cases for verify_c_comments.py. Each case gives old/new file contents (\\n = LF). 'expect' is the rule id that MUST appear in the violations, or 'ok' when the pair must pass without violations. 'expect_warning' optionally names a warning that must appear.",
  "cases": [
    {
      "id": "pos-identical",
      "expect": "ok",
      "old": "int a; /* x */\n",
      "new": "int a; /* x */\n"
    },
    {
      "id": "pos-translate-block",
      "expect": "ok",
      "old": "int a; /* return value */\n",
      "new": "int a; /* 返回值 */\n"
    },
    {
      "id": "pos-translate-line",
      "expect": "ok",
      "old": "int a; // return value\n",
      "new": "int a; // 返回值\n"
    },
    {
      "id": "pos-multiline-same-lf",
      "expect": "ok",
      "old": "/*\n * one\n * two\n */\nint a;\n",
      "new": "/*\n * 一\n * 二\n */\nint a;\n"
    },
    {
      "id": "pos-spliced-macro-comment",
      "expect": "ok",
      "old": "#define F(x) \\\n\t(x) /* twice */ \\\n\t+ 1\n",
      "new": "#define F(x) \\\n\t(x) /* 两次 */ \\\n\t+ 1\n"
    },
    {
      "id": "pos-comment-with-code-ident",
      "expect": "ok",
      "old": "/* see heap_insert() and XLogRecPtr */\n",
      "new": "/* 参见 heap_insert() 和 XLogRecPtr */\n"
    },
    {
      "id": "pos-comment-containing-star-slash-like",
      "expect": "ok",
      "old": "/* a*b / c */\n",
      "new": "/* a*b / c 乘除 */\n"
    },
    {
      "id": "pos-raw-string-untouched",
      "expect": "ok",
      "old": "auto s = R\"x(/* keep */)x\"; /* c */\n",
      "new": "auto s = R\"x(/* keep */)x\"; /* 注释 */\n"
    },
    {
      "id": "pos-comment-then-spliced-code",
      "expect": "ok",
      "old": "#define X /* English */\\\n  1\n",
      "new": "#define X /* 英文 */\\\n  1\n"
    },
    {
      "id": "pos-ppport-shape-continuations",
      "expect": "ok",
      "old": "#define S(c) ((c) == 0x202F  /* Unicode 3.0 */\\\n    || (c) == 0x205F  /* Unicode 3.2 */\\\n    || (c) == 0x3000)\n",
      "new": "#define S(c) ((c) == 0x202F  /* Unicode 3.0 版 */\\\n    || (c) == 0x205F  /* Unicode 3.2 版 */\\\n    || (c) == 0x3000)\n"
    },
    {
      "id": "neg-splice-after-comment-removed",
      "expect": "R1_SKELETON",
      "old": "#define X /* English */\\\n  1\n",
      "new": "#define X /* 英文 */  1\n"
    },
    {
      "id": "neg-code-after-spliced-comment-changed",
      "expect": "R1_SKELETON",
      "old": "#define X /* English */\\\n  1\n",
      "new": "#define X /* English */\\\n  2\n"
    },
    {
      "id": "neg-include-after-multiline-comment",
      "expect": "R1_SKELETON",
      "old": "int x; /* spans\n */ #include <path//header.h>\n",
      "new": "int x; /* spans\n */ #include <path//CHANGED!>\n"
    },
    {
      "id": "neg-include-after-multiline-comment-at-bol",
      "expect": "R1_SKELETON",
      "old": "/* spans\n */ #include <path//header.h>\n",
      "new": "/* spans\n */ #include <path//CHANGED!>\n"
    },
    {
      "id": "neg-include-comment-inside-directive",
      "expect": "R1_SKELETON",
      "old": "#include /* a\n */ <x//y.h>\n",
      "new": "#include /* a\n */ <x//z.h>\n"
    },
    {
      "id": "pos-translate-multiline-comment-before-hash",
      "expect": "ok",
      "old": "int x; /* spans\n * lines */ #include <path//header.h>\n",
      "new": "int x; /* 跨越\n * 多行 */ #include <path//header.h>\n"
    },
    {
      "id": "neg-code-changed",
      "expect": "R1_SKELETON",
      "old": "int a = 1; /* x */\n",
      "new": "int a = 2; /* x */\n"
    },
    {
      "id": "neg-string-changed",
      "expect": "R1_SKELETON",
      "old": "elog(ERROR, \"bad value\"); /* x */\n",
      "new": "elog(ERROR, \"错误的值\"); /* x */\n"
    },
    {
      "id": "neg-string-comment-marker-changed",
      "expect": "R1_SKELETON",
      "old": "const char *s = \"/* not comment */\";\n",
      "new": "const char *s = \"/* 不是注释 */\";\n"
    },
    {
      "id": "neg-char-literal-changed",
      "expect": "R1_SKELETON",
      "old": "char c = 'a'; /* x */\n",
      "new": "char c = 'b'; /* x */\n"
    },
    {
      "id": "neg-whitespace-changed",
      "expect": "R1_SKELETON",
      "old": "int a;\t/* x */\n",
      "new": "int a; /* x */\n"
    },
    {
      "id": "neg-trailing-space-added",
      "expect": "R1_SKELETON",
      "old": "int a; /* x */\n",
      "new": "int a; /* x */ \n"
    },
    {
      "id": "neg-newline-added-outside",
      "expect": "R1_SKELETON",
      "old": "int a; /* x */\nint b;\n",
      "new": "int a; /* x */\n\nint b;\n"
    },
    {
      "id": "neg-comment-removed",
      "expect": "R1_SKELETON",
      "old": "int a; /* x */\n",
      "new": "int a; \n"
    },
    {
      "id": "neg-comment-added",
      "expect": "R1_SKELETON",
      "old": "int a;\n",
      "new": "int a; /* 新 */\n"
    },
    {
      "id": "neg-comment-moved",
      "expect": "R1_SKELETON",
      "old": "int a; /* x */\nint b;\n",
      "new": "int a;\nint b; /* x */\n"
    },
    {
      "id": "neg-crlf-outside",
      "expect": "R1_SKELETON",
      "old": "int a; /* x */\n",
      "new": "int a; /* x */\r\n"
    },
    {
      "id": "neg-fullwidth-space-outside",
      "expect": "R1_SKELETON",
      "old": "int a; /* x */\n",
      "new": "int a;　/* x */\n"
    },
    {
      "id": "neg-include-changed",
      "expect": "R1_SKELETON",
      "old": "#include <a.h> /* x */\n",
      "new": "#include <b.h> /* x */\n"
    },
    {
      "id": "neg-directive-changed",
      "expect": "R1_SKELETON",
      "old": "#define X 1 /* x */\n",
      "new": "#define X 2 /* x */\n"
    },
    {
      "id": "neg-splice-removed",
      "expect": "R1_SKELETON",
      "old": "#define F \\\n 1 /* x */\n",
      "new": "#define F 1 /* x */\n"
    },
    {
      "id": "neg-raw-string-changed",
      "expect": "R1_SKELETON",
      "old": "auto s = R\"x(/* keep */)x\"; /* c */\n",
      "new": "auto s = R\"x(/* 改 */)x\"; /* c */\n"
    },
    {
      "id": "neg-code-commented-out",
      "expect": "R1_SKELETON",
      "old": "int a;\nint b;\n",
      "new": "int a;\n/* int b; */\n"
    },
    {
      "id": "neg-comment-split-in-two",
      "expect": "R1_SKELETON",
      "old": "/* one two */\n",
      "new": "/* 一 *//* 二 */\n"
    },
    {
      "id": "neg-kind-block-to-line",
      "expect": "R2_KIND",
      "old": "int a; /* x */\n",
      "new": "int a; // x\n"
    },
    {
      "id": "neg-kind-line-to-block",
      "expect": "R2_KIND",
      "old": "int a; // x\n",
      "new": "int a; /* x */\n"
    },
    {
      "id": "neg-kind-line-to-block-same-len",
      "expect": "R2_KIND",
      "old": "int a; // xx\n",
      "new": "int a; /*x*/\n"
    },
    {
      "id": "neg-early-close",
      "expect": "R1_SKELETON",
      "old": "int a; /* one two */ int b;\n",
      "new": "int a; /* 一 */ 二 */ int b;\n"
    },
    {
      "id": "neg-nested-open",
      "expect": "R3_NESTED_OPEN",
      "old": "/* one two */\n",
      "new": "/* 一 /* 二 */\n"
    },
    {
      "id": "neg-line-comment-trailing-backslash",
      "expect": "R1_SKELETON",
      "old": "int a; // x\nint b;\n",
      "new": "int a; // x \\\nint b;\n"
    },
    {
      "id": "neg-line-comment-trailing-backslash-eof",
      "expect": "R3_LINE_BACKSLASH",
      "old": "int a; // x",
      "new": "int a; // x \\"
    },
    {
      "id": "neg-bom",
      "expect": "R4_BOM",
      "old": "int a; /* x */\n",
      "new": "﻿int a; /* x */\n"
    },
    {
      "id": "neg-cr-in-comment",
      "expect": "R4_CR",
      "old": "/* a\n b */\n",
      "new": "/* 甲\r\n 乙 */\n"
    },
    {
      "id": "neg-translator-comment",
      "expect": "R5_PROTECTED",
      "old": "/* translator: %s is a name */\n",
      "new": "/* 译者: %s 是名字 */\n"
    },
    {
      "id": "neg-fallthrough",
      "expect": "R5_PROTECTED",
      "old": "/* FALLTHROUGH */\n",
      "new": "/* 继续执行 */\n"
    },
    {
      "id": "neg-falls-through-prose",
      "expect": "R5_PROTECTED",
      "old": "/* this case falls through to the next */\n",
      "new": "/* 此分支穿透到下一个 */\n"
    },
    {
      "id": "neg-fall-thru",
      "expect": "R5_PROTECTED",
      "old": "// fall thru\n",
      "new": "// 穿透\n"
    },
    {
      "id": "neg-pg-attribute",
      "expect": "R5_PROTECTED",
      "old": "/* uses pg_attribute_noreturn() */\n",
      "new": "/* 使用 pg_attribute_noreturn() */\n"
    },
    {
      "id": "pos-pgindent-block-translatable",
      "expect": "ok",
      "old": "/*-\n * aligned table\n */\n",
      "new": "/*-\n * 对齐的表格\n */\n"
    },
    {
      "id": "neg-copyright",
      "expect": "R5_PROTECTED",
      "old": "/* Copyright (c) 2023, Example */\n",
      "new": "/* 版权所有 (c) 2023, Example */\n"
    },
    {
      "id": "neg-license",
      "expect": "R5_PROTECTED",
      "old": "/* Released under the PostgreSQL License */\n",
      "new": "/* 按 PostgreSQL 许可证发布 */\n"
    },
    {
      "id": "pos-header-module-translated",
      "expect": "ok",
      "old": "/*-------------------------------------------------------------------------\n *\n * barrier.c\n *\t  Barriers for synchronizing cooperating processes.\n *\n * Portions Copyright (c) 1996-2023, PostgreSQL Global Development Group\n *\n * NOTES\n *\t  A barrier waits until all participants arrive.\n *\n * IDENTIFICATION\n *\t  src/backend/storage/ipc/barrier.c\n *\n *-------------------------------------------------------------------------\n */\n",
      "new": "/*-------------------------------------------------------------------------\n *\n * barrier.c\n *\t  用于同步协作进程的屏障。\n *\n * Portions Copyright (c) 1996-2023, PostgreSQL Global Development Group\n *\n * NOTES\n *\t  屏障会等待直到所有参与者到达。\n *\n * IDENTIFICATION\n *\t  src/backend/storage/ipc/barrier.c\n *\n *-------------------------------------------------------------------------\n */\n"
    },
    {
      "id": "neg-header-legal-modified",
      "expect": "R5_PROTECTED",
      "old": "/*-------------------------------------------------------------------------\n *\n * barrier.c\n *\t  Barriers for synchronizing cooperating processes.\n *\n * Portions Copyright (c) 1996-2023, PostgreSQL Global Development Group\n *\n * NOTES\n *\t  A barrier waits until all participants arrive.\n *\n * IDENTIFICATION\n *\t  src/backend/storage/ipc/barrier.c\n *\n *-------------------------------------------------------------------------\n */\n",
      "new": "/*-------------------------------------------------------------------------\n *\n * barrier.c\n *\t  用于同步协作进程的屏障。\n *\n * 部分版权 (c) 1996-2023, PostgreSQL Global Development Group\n *\n * NOTES\n *\t  屏障会等待直到所有参与者到达。\n *\n * IDENTIFICATION\n *\t  src/backend/storage/ipc/barrier.c\n *\n *-------------------------------------------------------------------------\n */\n"
    },
    {
      "id": "neg-lf-added-in-comment",
      "expect": "R6_LF_COUNT",
      "old": "/* one two three */\nint a;\n",
      "new": "/* 一\n * 二三 */\nint a;\n"
    },
    {
      "id": "neg-lf-removed-in-comment",
      "expect": "R6_LF_COUNT",
      "old": "/*\n * one\n * two\n */\n",
      "new": "/*\n * 一二\n */\n"
    },
    {
      "id": "neg-trigraph-new",
      "expect": "R8_TRIGRAPH_NEW",
      "old": "/* what? */\n",
      "new": "/* 什么??) */\n"
    },
    {
      "id": "neg-trigraph-baseline-modified",
      "expect": "R8_TRIGRAPH_BASE",
      "old": "/* ??) is a trigraph */\n",
      "new": "/* ??) 是三字符组 */\n"
    },
    {
      "id": "pos-trigraph-baseline-kept",
      "expect": "ok",
      "old": "/* ??) is a trigraph */\nint a; /* other */\n",
      "new": "/* ??) is a trigraph */\nint a; /* 其他 */\n"
    },
    {
      "id": "warn-untranslated",
      "expect": "ok",
      "expect_warning": "W7_UNTRANSLATED",
      "old": "/* This is a long English sentence that was not translated. */\n/* b */\n",
      "new": "/* This is a long English sentence that was not translated. */\n/* 乙 */\n"
    },
    {
      "id": "warn-ident-lost",
      "expect": "ok",
      "expect_warning": "W7_IDENT_LOST",
      "old": "/* calls heap_insert() here */\n",
      "new": "/* 这里调用插入函数 */\n"
    },
    {
      "id": "pos-header-see-for-license-translated",
      "expect": "ok",
      "old": "/*-------------------------------------------------------------------------\n *\n * rbtree.c\n *\t  implementation.\n *\n * See example.htm for\n * license terms: \"Source code, when part of a software project, may be used\n * freely without reference to the author.\"\n *\n * Copyright (c) 2009-2023, PostgreSQL Global Development Group\n *\n * IDENTIFICATION\n *\t  src/backend/lib/rbtree.c\n *-------------------------------------------------------------------------\n */\n",
      "new": "/*-------------------------------------------------------------------------\n *\n * rbtree.c\n *\t  实现。\n *\n * 见 example.htm 的\n * license terms: \"Source code, when part of a software project, may be used\n * freely without reference to the author.\"\n *\n * Copyright (c) 2009-2023, PostgreSQL Global Development Group\n *\n * IDENTIFICATION\n *\t  src/backend/lib/rbtree.c\n *-------------------------------------------------------------------------\n */\n"
    },
    {
      "id": "neg-header-license-quote-split",
      "expect": "R5_PROTECTED",
      "old": "/*-------------------------------------------------------------------------\n *\n * rbtree.c\n *\t  implementation.\n *\n * See example.htm for\n * license terms: \"Source code, when part of a software project, may be used\n * freely without reference to the author.\"\n *\n * Copyright (c) 2009-2023, PostgreSQL Global Development Group\n *\n * IDENTIFICATION\n *\t  src/backend/lib/rbtree.c\n *-------------------------------------------------------------------------\n */\n",
      "new": "/*-------------------------------------------------------------------------\n *\n * rbtree.c\n *\t  implementation.\n *\n * See example.htm for\n * license terms: \"Source code, when part of a software project, may be used\n * 可自由使用，无需注明作者。\"\n *\n * Copyright (c) 2009-2023, PostgreSQL Global Development Group\n *\n * IDENTIFICATION\n *\t  src/backend/lib/rbtree.c\n *-------------------------------------------------------------------------\n */\n"
    }
  ]
}
